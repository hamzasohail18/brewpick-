# --- Database ---
# Postgres connection string (Supabase: Project Settings > Database). Leave blank for local dev:
# the app then uses an embedded PGlite database in PGLITE_DIR, migrated and seeded automatically.
DATABASE_URL=
# PGLITE_DIR=.data/pglite

# --- Supabase Auth (from `supabase start` locally, or the project dashboard) ---
# Leave blank for local dev to use the dev-only admin sign-in (disabled in production).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by admin routes, collectors and the publisher. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Collectors ---
# Contact address in the collector User-Agent. Collectors refuse to run until this is set.
COLLECTOR_CONTACT_EMAIL=
# Optional API keys; collectors for these sources stay disabled until set AND the source is reviewed.
GOOGLE_PLACES_API_KEY=
USDA_FDC_API_KEY=
# "queue": Run now only queues the run and `npm run scheduler` starts it (for serverless hosts).
# COLLECTOR_EXECUTION=queue
# Slack-compatible incoming webhook for scheduler failure alerts.
# ALERT_WEBHOOK_URL=

# --- Map ---
# Tile template for Leaflet. Default: OpenStreetMap standard tiles (fine for dev; use a tile provider in production).
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# --- Local dev ---
# Comma-separated LAN hosts allowed to load the dev server (to test on a real phone over Wi-Fi).
# DEV_ALLOWED_ORIGINS=192.168.1.20
