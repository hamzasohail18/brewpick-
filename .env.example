# --- Supabase (from `supabase start` locally, or the project dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by admin routes, collectors and the publisher. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Collectors ---
# Contact address put in the collector User-Agent (also update sources.user_agent rows).
COLLECTOR_CONTACT_EMAIL=
# Optional API keys; collectors for these sources stay disabled until set AND the source is reviewed.
GOOGLE_PLACES_API_KEY=
USDA_FDC_API_KEY=
